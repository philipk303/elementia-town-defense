{
  "name": "elementia-town-defense",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "npm-run-all --parallel dev:client dev:server",
    "dev:client": "vite --config client/vite.config.js",
    "dev:server": "nodemon server/index.js",
    "build": "vite build --config client/vite.config.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:audio": "node --test test/client/audioMap.test.js",
    "test:asset-delivery": "node --test test/assetDelivery.test.js",
    "build:manifest": "node tools/art/build_manifest.js",
    "test:e2e": "node client/test/e2e_smoke.mjs",
    "bench:run": "node test/harness/bench/run.mjs",
    "bench:analyze": "node test/harness/bench/analyze.mjs",
    "spike:a": "node spikes/spikeA-budget.js",
    "spike:b": "node --expose-gc spikes/spikeB-scale.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "howler": "^2.2.4",
    "phaser": "^3.87.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.60.0",
    "vite": "^5.4.0"
  }
}
